# ========================================================
# Apache / LiteSpeed Configuration for Sahabat Kaca Aluminium
# Domain: https://sahabat-aluminium.my.id/
# ========================================================

Options -Indexes

# 1. MIME Types Configuration
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddCharset UTF-8 .xml
  AddCharset UTF-8 .txt
</IfModule>

# 2. HTTP Headers for Crawlers & Google Search Console
<IfModule mod_headers.c>
  <FilesMatch "\.(xml|txt)$">
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=UTF-8"
  </Files>

  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=UTF-8"
  </Files>
</IfModule>

# 3. Rewrite Rules & Canonical Domain
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # NEVER redirect or rewrite sitemap.xml or robots.txt
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^sitemap-nonwww\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^ads\.txt$ - [L]

  # 1. Direct single-hop 301 redirect for index.html to canonical root
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
  RewriteRule ^index\.html$ https://sahabat-aluminium.my.id/ [R=301,L]

  # 2. Redirect www to non-www (HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.sahabat-aluminium\.my\.id$ [NC]
  RewriteRule ^(.*)$ https://sahabat-aluminium.my.id/$1 [R=301,L]

  # 3. Enforce HTTPS on apex domain
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://sahabat-aluminium.my.id/$1 [R=301,L]

  # Clean URLs for articles: /artikel/slug -> /artikel/slug.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/artikel/$1.html -f
  RewriteRule ^artikel/([^/]+)/?$ artikel/$1.html [L]

  # Clean URLs for landing pages: /jasa-... -> /jasa-....html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
